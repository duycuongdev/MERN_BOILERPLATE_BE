# Environment Mode ('dev' | 'production')
BUILD_MODE=dev

# Application Details
AUTHOR=Duy Cuong
LOCAL_DEV_APP_HOST=localhost
LOCAL_DEV_APP_PORT=8017

# MongoDB Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=mern-boilerplate-db

# Website Domains (For CORS & Verification links)
WEBSITE_DOMAIN_DEVELOPMENT=http://localhost:5173
WEBSITE_DOMAIN_PRODUCTION=https://your-production-app.vercel.app

# Brevo (Sendinblue) Transactional Email Service
# Note: BREVO_API_KEY must start with 'xkeysib-' (API Key v3), NOT 'xsmtpsib-'
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
ADMIN_EMAIL_ADDRESS=your-email@example.com
ADMIN_EMAIL_NAME=MERN Boilerplate Admin

# JWT Token Configuration
# Generate secure random strings for signatures (e.g. openssl rand -base64 32)
ACCESS_TOKEN_SECRET_SIGNATURE=your_jwt_access_token_secret_signature_here
ACCESS_TOKEN_LIFE=1h
REFRESH_TOKEN_SECRET_SIGNATURE=your_jwt_refresh_token_secret_signature_here
REFRESH_TOKEN_LIFE=14d

# Cloudinary Storage (For file/avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

